# Copie para .env e preencha. O .env NUNCA vai para o git — guarde-o num cofre de senhas.

# --- Administrador inicial (obrigatório ADMIN_PASSWORD com banco vazio) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=

# --- Chave mestra: cifra credenciais e chaves de backup. Gere com: openssl rand -base64 32 ---
# Perdê-la torna credenciais salvas e backups criptografados irrecuperáveis.
APP_SECRET_KEY=

# --- Máquina LOCAL (o host onde o m2m roda). Numa VPS: M2M_LOCAL_ENABLED=false e HOST_HOME_BIND vazio ---
M2M_LOCAL_ENABLED=true
HOST_HOME_BIND=/home
HOST_ROOTS=/home

# --- Publicação e TLS (vazio em TLS_* = certificado autoassinado gerado no primeiro start) ---
PUBLIC_URL=https://192.168.0.11
HTTP_PORT=80
HTTPS_PORT=443
TLS_CERT_PATH=
TLS_KEY_PATH=

# --- Logs (Grafana + Loki + Alloy; Grafana em HTTPS com o mesmo certificado acima) ---
# Senha do admin do Grafana (obrigatória). Gere com: openssl rand -base64 18
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=3000
# 127.0.0.1 = só esta máquina. Para abrir o Grafana na rede (ex.: botão da Auditoria em outro PC) use 0.0.0.0
GRAFANA_BIND=127.0.0.1
# Quanto tempo os logs ficam guardados (7 dias)
LOKI_RETENTION=168h

# --- Transferências simultâneas (tela de transferência) ---
TRANSFER_CONCURRENCY=2

# --- Banco e fila (rede interna do compose) ---
POSTGRES_DB=m2m
POSTGRES_USER=m2m
POSTGRES_PASSWORD=
RABBITMQ_USER=m2m
RABBITMQ_PASSWORD=

TZ=America/Sao_Paulo
